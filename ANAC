cat("\n=== TABELA COMPLETA DE PEERS ===\n\n")
print(df_peers %>%
  select(DMU, DMU_eff, Peer, Lambda) %>%
  arrange(DMU, desc(Lambda)) %>%
  as.data.frame(), row.names = FALSE)

